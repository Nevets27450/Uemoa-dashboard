// Exécuter dans la vue Requête DAX de Power BI Desktop après actualisation.
// Attendus : 2 080 cas, 0 erreur de rang, 0 erreur de série.
EVALUATE
VAR Grille =
    SUMMARIZECOLUMNS(
        'donnees_uemoa_large'[Pays],
        'donnees_uemoa_large'[Année],
        'KPI'[Indicateur],
        "Rang", [Rang_Indic],
        "B", [Rang Focus Benin],
        "A", [Rang Autres Pays]
    )
RETURN
    ROW(
        "Cas", COUNTROWS(Grille),
        "Rangs invalides", COALESCE(COUNTROWS(FILTER(Grille, [Rang] < 1 || [Rang] > 8 || ISBLANK([Rang]))), 0),
        "Series invalides", COALESCE(COUNTROWS(FILTER(Grille,
            IF('donnees_uemoa_large'[Pays] = "Bénin",
                [B] <> [Rang] || NOT ISBLANK([A]),
                [A] <> [Rang] || NOT ISBLANK([B])))), 0)
    )

// Attendus : 520 cas et 0 écart pour chaque agrégat.
EVALUATE
VAR Tests =
    SUMMARIZECOLUMNS(
        'donnees_uemoa_large'[Pays], 'donnees_uemoa_large'[Année],
        "PIB", [Vue PIB], "PIB attendu", SUM('donnees_uemoa_large'[PIB (USD)]),
        "Population", [Vue Population], "Population attendue", SUM('donnees_uemoa_large'[Population totale]),
        "Hab", [Vue PIB habitant], "Hab attendu", DIVIDE(SUM('donnees_uemoa_large'[PIB (USD)]), SUM('donnees_uemoa_large'[Population totale]))
    )
RETURN
    ROW(
        "Cas", COUNTROWS(Tests),
        "Ecarts PIB", COALESCE(COUNTROWS(FILTER(Tests, ABS([PIB] - [PIB attendu]) > 0.01)), 0),
        "Ecarts population", COALESCE(COUNTROWS(FILTER(Tests, [Population] <> [Population attendue])), 0),
        "Ecarts habitant", COALESCE(COUNTROWS(FILTER(Tests, ABS([Hab] - [Hab attendu]) > 0.00001)), 0)
    )

// Attendus : 520 lignes, 0 doublon, année SMIG 2025.
EVALUATE
ROW(
    "Lignes", COUNTROWS('donnees_uemoa_large'),
    "Doublons", COUNTROWS('donnees_uemoa_large') - COUNTROWS(SUMMARIZE('donnees_uemoa_large', 'donnees_uemoa_large'[Pays], 'donnees_uemoa_large'[Année])),
    "Annee SMIG", MAX('smig_uemoa_2024'[Année]),
    "PIB", [Vue PIB], "Population", [Vue Population], "Habitant", [Vue PIB habitant],
    "Importations", [Vue Importations], "Exportations", [Vue Exportations]
)
